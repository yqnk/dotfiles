#!/bin/sh
# Dim the backlight in a few steps, lock, then bring it back.

pidof -q hyprlock && exit 0

# hyprlock is started from a compositor bind, not from a login shell, so
# the path its config refers to has to be put in the environment here.
export WALLPAPERS="${WALLPAPERS:-$HOME/.local/share/wallpapers}"

target=19 # percent, the old 18000/96000
cur=$(brightnessctl -m | cut -d, -f4 | tr -d %)

fade() { # from to
    for step in 1 2 3 4; do
        brightnessctl -q set "$(($1 + ($2 - $1) * step / 4))%"
        sleep 0.03
    done
}

[ "$cur" -gt "$target" ] && fade "$cur" "$target"
hyprlock
[ "$cur" -gt "$target" ] && fade "$target" "$cur"

exit 0
